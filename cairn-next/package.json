{
  "name": "cairn-next",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Local project collaboration and recovery for teams on the same LAN",
  "author": "Cairn Next contributors",
  "license": "UNLICENSED",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json",
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "node --test --test-concurrency=1 dist/tests/*.test.js",
    "verify": "node scripts/verify.cjs",
    "test:desktop": "node tests/release.e2e.cjs && node tests/startup-close.e2e.cjs",
    "runtime:check": "node scripts/runtime-check.cjs",
    "start": "electron .",
    "dev:web": "vite --host 127.0.0.1",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "licenses": "node scripts/generate-notices.cjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "chokidar": "6.0.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "ignore": "7.0.14",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "ws": "8.22.0",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.25.0",
  "build": {
    "appId": "local.cairn.next",
    "productName": "Cairn Next",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/core/**",
      "!dist/core/*-cli.js",
      "dist/shared/**",
      "dist/electron/**",
      "!**/*.map",
      "web-dist/**",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "docs/privacy.md",
      "docs/user-guide.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
